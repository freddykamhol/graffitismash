# NODE_ENV=production im Hosting/Prozessmanager setzen, nicht in dieser Datei.
PORT=80
PUBLIC_URL=https://graffitismash.de
DATA_DIR=./data
ORDER_RETENTION_DAYS=90
# Mindestens 32 zufällige Zeichen. Nach Inbetriebnahme nicht ändern, sonst sind gespeicherte Secrets unlesbar.
APP_MASTER_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Nur beim ersten Start zur Anlage des initialen Administrators erforderlich.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=CHANGE_ME_TO_AT_LEAST_14_CHARACTERS
