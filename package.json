    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
